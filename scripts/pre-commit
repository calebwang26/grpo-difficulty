#!/bin/sh
# Pre-commit secret scan. Install with `make hooks`.
# Blocks the commit if gitleaks finds a secret in the staged changes.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Commit blocked." >&2
  exit 1
fi
exec gitleaks protect --staged --redact --no-banner --log-level warn --config .gitleaks.toml
